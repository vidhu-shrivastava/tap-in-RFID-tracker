# =============================================================================
# Tap-In RFID Attendance Tracker — .gitignore
# Keep secrets, local machine junk, and build artifacts out of Git.
# =============================================================================

# -----------------------------------------------------------------------------
# Secrets & local credentials (NEVER commit these)
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example

# Local Supabase key overrides (copy from the .example file)
frontend/js/supabase.local.js

# Local admin gate password (copy from admin.local.js.example)
frontend/js/admin.local.js

# Backend receive env (copy from backend/.env.example)
backend/.env

# Catch-all folders people sometimes dump keys into
secrets/
*.pem
*.p12
*.key
credentials.json
service-account*.json

# Arduino / hardware WiFi or API secrets (if you add them later)
hardware/**/secrets.h
hardware/**/arduino_secrets.h
hardware/**/wifi_credentials.h

# -----------------------------------------------------------------------------
# OS junk
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
Thumbs.db
Desktop.ini
ehthumbs.db

# -----------------------------------------------------------------------------
# Editors / IDEs
# -----------------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# -----------------------------------------------------------------------------
# Node / frontend tooling (we use CDN only, but ignore if anyone npm-inits)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml
dist/
build/
.cache/
.parcel-cache/
.next/
.vite/

# -----------------------------------------------------------------------------
# Logs & temp
# -----------------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# -----------------------------------------------------------------------------
# Arduino / PlatformIO (if used later)
# -----------------------------------------------------------------------------
.pio/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# -----------------------------------------------------------------------------
# Supabase CLI local state (if you install the CLI later)
# -----------------------------------------------------------------------------
supabase/.temp/
supabase/.branches/

# -----------------------------------------------------------------------------
# Per-person plans (do not merge onto main / do not push these)
# -----------------------------------------------------------------------------
WEEK_1_PLAN.md
PHASE_2_PLAN.md

# Phase 2 plans MAY be committed on feature branches so teammates can pull them.
# Never put real Supabase keys or admin passwords inside PHASE_2_PLAN.md.

# -----------------------------------------------------------------------------
# Local scratch / merge artifacts (never commit)
# -----------------------------------------------------------------------------
.extracted_from_transcript/
.extract_transcript_html.py
