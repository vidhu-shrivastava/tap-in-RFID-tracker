/*
 * Copy this file to:  arduino_secrets.h
 * arduino_secrets.h is gitignored — never commit real WiFi passwords.
 *
 * For local demos, a phone hotspot works (SSID/password below).
 * Point TAP_IN_HOST at wherever backend/receive_scan.py is running.
 */

#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

#define SECRET_WIFI_SSID "YOUR_HOTSPOT_NAME"
#define SECRET_WIFI_PASS "YOUR_HOTSPOT_PASSWORD"

// Hostname or IP of the machine/server running backend/receive_scan.py
// Examples: "10.0.0.5"  or  "yourclubwebsite.com"
#define TAP_IN_HOST "127.0.0.1"
#define TAP_IN_PORT 8787
#define TAP_IN_PATH "/scan"

#endif
