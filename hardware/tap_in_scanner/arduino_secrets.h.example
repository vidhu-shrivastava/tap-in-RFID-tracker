/*
 * Copy this file to:  arduino_secrets.h
 * arduino_secrets.h is gitignored — never commit real WiFi passwords.
 *
 * HOTSPOT DEMO
 * ------------
 * 1. Laptop + Arduino join the same phone/laptop hotspot (SSID/password below).
 * 2. On the laptop: cd backend && python3 receive_scan.py
 *    (default bind 0.0.0.0:8787 — accepts WiFi clients on the hotspot)
 * 3. Set TAP_IN_HOST to the LAPTOP's hotspot/LAN IP printed by receive_scan.py
 *    (often 192.168.x.x). NEVER use 127.0.0.1 here — that is "this board",
 *    not the laptop, so POST /scan will fail.
 * 4. USB is only for power + Serial Monitor debugging. Check-ins use WiFi HTTP.
 */

#ifndef ARDUINO_SECRETS_H
#define ARDUINO_SECRETS_H

#define SECRET_WIFI_SSID "YOUR_HOTSPOT_NAME"
#define SECRET_WIFI_PASS "YOUR_HOTSPOT_PASSWORD"

// Hostname or IP of the machine/server running backend/receive_scan.py
// Hotspot demo example: "192.168.43.10"  |  later KTP: "yourclubwebsite.com"
#define TAP_IN_HOST "192.168.0.10"
#define TAP_IN_PORT 8787
#define TAP_IN_PATH "/scan"

#endif
