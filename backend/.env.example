# Copy to backend/.env (gitignored). Use the SAME values as frontend/js/supabase.local.js
# Cloud Supabase only — do not use Docker / 127.0.0.1:54321.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Bind address for this receive process (runs on your laptop / KTP server).
# 0.0.0.0 = accept taps from Arduino on the same hotspot / LAN.
# Use 127.0.0.1 only if you intentionally want laptop-local curl only.
TAP_IN_HOST=0.0.0.0
TAP_IN_PORT=8787
