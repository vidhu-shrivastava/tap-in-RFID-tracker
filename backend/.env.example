# Copy to backend/.env (gitignored). Use the SAME values as frontend/js/supabase.local.js
# Cloud Supabase only — do not use Docker / 127.0.0.1:54321.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional bind address (this receive process still runs on your laptop)
TAP_IN_HOST=127.0.0.1
TAP_IN_PORT=8787
